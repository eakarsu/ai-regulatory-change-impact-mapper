DATABASE_URL=postgresql://regulatory_user:replace_me@127.0.0.1:5432/regulatory_impact
AUTH_SECRET=replace-with-at-least-32-random-characters
DEFAULT_TENANT_ID=replace-with-tenant-id
OIDC_ISSUER=https://identity.example/replace-me
OIDC_CLIENT_ID=replace-me
OIDC_CLIENT_SECRET=replace-me-if-confidential-client
OIDC_REDIRECT_URI=https://regulatory.example/api/auth/oidc/callback
OIDC_ROLE_CLAIM=groups
OIDC_TENANT_CLAIM=tenant_id
OIDC_ROLE_MAP_JSON={"regulatory-admin":"admin","regulatory-manager":"manager","regulatory-analyst":"analyst"}
ADMIN_EMAIL=
ADMIN_PASSWORD=
ALLOW_LOCAL_PASSWORD_LOGIN=false
